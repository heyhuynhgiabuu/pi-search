{
	"name": "@heyhuynhgiabuu/pi-search",
	"version": "0.3.3",
	"description": "Research tools for the Pi coding agent: web search, code search, documentation, repository Q&A, fetching, and Firecrawl scraping/crawling.",
	"keywords": [
		"exa",
		"extension",
		"pi",
		"pi-coding-agent",
		"pi-package",
		"research",
		"web-search"
	],
	"homepage": "https://github.com/heyhuynhgiabuu/pi-search#readme",
	"bugs": {
		"url": "https://github.com/heyhuynhgiabuu/pi-search/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/heyhuynhgiabuu/pi-search.git"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run --coverage",
		"test:watch": "vitest",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
		"build": "tsc",
		"prepublishOnly": "npm run check && npm run build",
		"release:dry-run": "npm publish --dry-run",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"linkedom": "^0.18.12",
		"turndown": "^7.2.4",
		"unpdf": "^1.6.2"
	},
	"devDependencies": {
		"@changesets/cli": "^2.30.0",
		"@earendil-works/pi-coding-agent": "^0.85.0",
		"@earendil-works/pi-server": "^0.85.0",
		"@earendil-works/pi-tui": "^0.85.0",
		"@oxlint/plugins": "1.83.0",
		"@types/node": "^24.0.0",
		"@types/turndown": "^5.0.6",
		"@vitest/coverage-v8": "^3.2.4",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"typebox": "1.3.7",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}
